# Copie para .env e ajuste conforme necessário. Nenhum valor aqui é um segredo real.

# --- Aplicação ---
APP_ENV=local
APP_HTTP_ADDR=:8080
APP_SHUTDOWN_TIMEOUT=15s

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=wagering
POSTGRES_USER=wagering_app
POSTGRES_PASSWORD=changeme-local-only
POSTGRES_SSLMODE=disable
POSTGRES_MAX_CONNS=10

# --- SQS / LocalStack ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_WAGER_TRANSACTIONS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_WAGER_TRANSACTIONS_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wager-events.fifo

# --- Keycloak / OIDC ---
OIDC_ISSUER_URL=http://localhost:8081/realms/wagering
OIDC_AUDIENCE=wagering-api
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=changeme-local-only

# --- Observabilidade ---
LOG_LEVEL=info
METRICS_ADDR=:9090
